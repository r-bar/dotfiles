#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = [
#   "cryptography",
#   "httpx",
#   "pyjwt",
# ]
#
# [tool.uv]
# exclude-newer = "2026-09-04T13:15:34-07:00"
# ///

import logging
import typing as t
import argparse
import base64
import json
import sys
from collections.abc import Sequence

import jwt


DEFAULT_ALLOWED_ALGS = (
    "HS256HS384HS512ES256ES256KES384ES512RS256RS384RS512PS256PS384PS512EdDSA"
)


class Cli:
    token: str | None

    alg: Sequence[str] | None
    aud: str | None
    exp: bool
    iss: str | None
    json: bool
    key: str
    sub: str | None
    test: bool
    verify: bool

    def __init__(self):
        self.parser = p = argparse.ArgumentParser(description="Validate a JWT token")
        p.add_argument(
            "-j", "--json", action="store_true", help="Output the decoded token as JSON"
        )
        p.add_argument("-k", "--key", help="Key to use for validation")
        p.add_argument(
            "-n",
            "--no-verify",
            action="store_false",
            dest="verify",
            help="Do not verify the token signature",
        )
        aud_group = p.add_mutually_exclusive_group()
        aud_group.add_argument(
            "--aud", default="", help="Audience to use for validation"
        )
        aud_group.add_argument(
            "--no-aud",
            dest="aud",
            action="store_const",
            const=None,
            help="Do not verify the token audience",
        )
        p.add_argument("--iss", help="Issuer to use for validation")
        p.add_argument(
            "--alg",
            type=lambda s: s.split(","),
            help="Algorithms to use for validation",
        )
        p.add_argument("--sub", help="Subject to use for validation")
        p.add_argument(
            "--no-exp",
            action="store_false",
            dest="exp",
            help="Do not verify the token expiration",
        )
        p.add_argument(
            "-t",
            "--test",
            action="store_true",
            help="Retuen a non-zero exit code if the token is invalid",
        )
        p.add_argument("token", nargs="?", help="JWT token to validate")
        for name, value in vars(p.parse_args()).items():
            setattr(self, name, value)

    def get_token(self) -> str:
        if self.token:
            return self.token
        return open(0).read().strip()


def decode_bytes(b64_str: str) -> bytes:
    padded = b64_str + "=" * ((-1 * len(b64_str)) % 4)
    return base64.b64decode(padded)


def decode_json(section: str) -> dict[str, t.Any]:
    """Decode a JWT section (header or payload)"""
    return json.loads(decode_bytes(section))


def verify(
    token: str,
    key: str,
    verify_alg: Sequence[str] | None = None,
    verify_aud: str | None = None,
    verify_sub: str | None = None,
    verify_iss: str | None = None,
    verify_exp: bool = True,
) -> tuple[bool, str]:
    options = {}
    verify_alg = DEFAULT_ALLOWED_ALGS if verify_alg is None else verify_alg
    leeway = 0 if verify_exp else 2147483647  # i32 max
    options["verify_exp"] = verify_exp
    options["verify_aud"] = verify_aud is not None
    try:
        jwt.decode(
            token,
            key,
            algorithms=verify_alg,
            subject=verify_sub,
            audience=verify_aud,
            issuer=verify_iss,
            leeway=leeway,
            options=options,
        )
        return True, ""
    except jwt.PyJWTError as e:
        reason = str(e)
        if reason == "Audience doesn't match" and verify_aud == "":
            reason += "\nnote: the audience check will fail by default if the token contains an aud claim and no --aud is provided"
            reason += "\n      alternatively use the --no-aud flag to disable the audience check"
        return False, reason


def pad(
    value: t.Any,
    width: int,
    align: t.Literal["left", "right", "center"],
    fill: str = " ",
):
    if len(fill) != 1:
        raise ValueError("fill must be a single character")
    text = str(value)
    pad_count = max(width - len(text), 0)
    left_pad: str
    right_pad: str
    match align:
        case "left":
            left_pad = ""
            right_pad = pad_count * fill
        case "right":
            right_pad = ""
            left_pad = pad_count * fill
        case "center":
            left_pad = (pad_count // 2) * fill
            right_pad = (pad_count - len(left_pad)) * fill
    return f"{right_pad}{text}{left_pad}"


def main():
    logging.basicConfig(level=logging.INFO, stream=sys.stderr)
    cli = Cli()

    token = cli.get_token()
    try:
        header_b64, claims_b64, signature_b64 = token.split(".")
    except Exception:
        print("Invalid JWT format", file=sys.stderr)
        exit(1)

    header = decode_json(header_b64)
    claims = decode_json(claims_b64)
    _signature = decode_bytes(signature_b64)

    iss = claims.get("iss")
    alg = header.get("alg")
    typ = header.get("typ")

    verified = False
    failure_reason = None
    if cli.verify:
        if cli.key:
            key = cli.key
        elif (
            iss is not None
            and alg is not None
            and typ == "JWT"
            and alg.startswith("RS")
        ):
            jwk = jwt.PyJWKClient(
                f"{iss.rstrip('/')}/.well-known/jwks.json"
            ).get_signing_key(header["kid"])
            key = jwk.key
        verified, failure_reason = verify(
            token,
            key,
            verify_alg=cli.alg,
            verify_aud=cli.aud,
            verify_sub=cli.sub,
            verify_iss=cli.iss,
            verify_exp=cli.exp,
        )

    if cli.json:
        output = {"header": header, "claims": claims, "verified": verified}
        if failure_reason:
            output["failure_reason"] = failure_reason
        json.dump(output, sys.stdout, indent=2)
    else:
        print("  Header", "=" * 10, json.dumps(header, indent=2), sep="\n", end="\n\n")
        print("  Claims", "=" * 10, json.dumps(claims, indent=2), sep="\n", end="\n\n")
        print(
            " Verified",
            "=" * 10,
            pad(verified, width=10, align="center").upper(),
            sep="\n",
        )
        if failure_reason:
            print("Verification failure reason:", failure_reason)
    exit(1 if cli.verify and cli.test and not verified else 0)


if __name__ == "__main__":
    main()
